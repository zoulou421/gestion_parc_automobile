<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_fuel_log_list" model="ir.ui.view">
        <field name="name">fleet.fuel.log.list</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <list string="Consommations carburant">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="liter" sum="Total litres"/>
                <field name="price_per_liter"/>
                <field name="total_amount" sum="Total"/>
                <field name="station"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_fuel_log_form" model="ir.ui.view">
        <field name="name">fleet.fuel.log.form</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <form string="Consommation carburant">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="odometer"/>
                            <field name="fuel_type"/>
                        </group>
                        <group>
                            <field name="liter"/>
                            <field name="price_per_liter"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="station"/>
                            <field name="inv_ref"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_fuel_log_search" model="ir.ui.view">
        <field name="name">fleet.fuel.log.search</field>
        <field name="model">fleet.fuel.log</field>
        <field name="arch" type="xml">
            <search string="Rechercher consommations">
                <field name="vehicle_id"/>
                <field name="station"/>
                <group expand="0" string="Grouper par">
                    <filter string="Véhicule" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_fuel_log" model="ir.actions.act_window">
        <field name="name">Carburant</field>
        <field name="res_model">fleet.fuel.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_fleet_fuel_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer le premier plein</p>
        </field>
    </record>

</odoo>