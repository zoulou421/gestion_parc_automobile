<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_technical_control_list" model="ir.ui.view">
        <field name="name">fleet.technical.control.list</field>
        <field name="model">fleet.technical.control</field>
        <field name="arch" type="xml">
            <list string="Contrôles techniques">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="next_date"/>
                <field name="result" widget="badge"
                        decoration-success="result == 'passed'"
                        decoration-warning="result == 'passed_with_observations'"
                        decoration-danger="result == 'failed'"/>
                <field name="center"/>
                <field name="cost" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_technical_control_form" model="ir.ui.view">
        <field name="name">fleet.technical.control.form</field>
        <field name="model">fleet.technical.control</field>
        <field name="arch" type="xml">
            <form string="Contrôle technique">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="next_date"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="center"/>
                            <field name="cost"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Observations..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_technical_control_search" model="ir.ui.view">
        <field name="name">fleet.technical.control.search</field>
        <field name="model">fleet.technical.control</field>
        <field name="arch" type="xml">
            <search string="Rechercher contrôles techniques">
                <field name="vehicle_id"/>
                <filter string="Favorable" name="passed" domain="[('result', '=', 'passed')]"/>
                <filter string="Défavorable" name="failed" domain="[('result', '=', 'failed')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Véhicule" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Résultat" name="group_result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fleet_technical_control_calendar" model="ir.ui.view">
        <field name="name">fleet.technical.control.calendar</field>
        <field name="model">fleet.technical.control</field>
        <field name="arch" type="xml">
            <calendar string="Contrôles techniques" date_start="date" color="result" mode="month">
                <field name="vehicle_id"/>
                <field name="result"/>
            </calendar>
        </field>
    </record>

    <record id="action_fleet_technical_control" model="ir.actions.act_window">
        <field name="name">Contrôles Techniques</field>
        <field name="res_model">fleet.technical.control</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_fleet_technical_control_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer le premier contrôle technique</p>
        </field>
    </record>

</odoo>