<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_garage_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.garage.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_maintenances" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not is_garage">
                    <field name="maintenance_count" widget="statinfo" string="Entretiens"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_garage"/>
                <field name="garage_specialty" invisible="not is_garage"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_garage_list" model="ir.ui.view">
        <field name="name">fleet.garage.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Garages / Fournisseurs">
                <field name="name"/>
                <field name="garage_specialty"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_garage_search" model="ir.ui.view">
        <field name="name">fleet.garage.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Rechercher garages">
                <field name="name"/>
                <field name="garage_specialty"/>
            </search>
        </field>
    </record>

    <record id="action_fleet_garage" model="ir.actions.act_window">
        <field name="name">Garages / Fournisseurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_garage', '=', True)]</field>
        <field name="context">{'default_is_garage': True}</field>
        <field name="search_view_id" ref="view_fleet_garage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer le premier garage / fournisseur</p>
        </field>
    </record>

</odoo>